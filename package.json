{
  "name": "seqflow",
  "version": "0.1.0",
  "private": true,
  "description": "Hybrid text/visual editor for microservice sequence diagrams, with an inferred architecture view.",
  "license": "MIT",
  "author": "Nic Defaux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheImitation/seqflow.git"
  },
  "homepage": "https://theimitation.github.io/seqflow/",
  "bugs": {
    "url": "https://github.com/TheImitation/seqflow/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node src/ai/proxy-server/server.mjs",
    "dev:all": "concurrently -n app,proxy -c cyan,magenta \"npm:dev\" \"npm:dev:proxy\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@dagrejs/dagre": "^3.1.1",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "docx": "^9.7.1",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
